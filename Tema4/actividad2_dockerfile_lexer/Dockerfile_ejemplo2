# Archivo Dockerfile de Ejemplo 2: Multi-stage Build y Directivas Avanzadas
# Demuestra flags (--platform, --from, --chown, --interval), ARG y HEALTHCHECK

ARG GO_VERSION=1.21
FROM --platform=linux/amd64 golang:${GO_VERSION}-alpine AS builder

WORKDIR /build

# Copiar configuración modular y compilar
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/api ./cmd/server

# Segunda etapa: Imagen mínima de producción
FROM alpine:3.18

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

WORKDIR /home/appuser/service

# Copiar el binario compilado desde la etapa anterior asignando permisos
COPY --from=builder --chown=appuser:appgroup /app/api ./api

# Verificación de salud periódica del contenedor
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000/tcp
ENTRYPOINT ["./api"]
